generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id          String   @id
  title       String
  description String
  price       Float
  category    String
  image       String
  brand       String?
  rating      Float?
  stock       Int      @default(0)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}
